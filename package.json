{
  "version": "0.2.3",
  "name": "mongoose-zod",
  "description": "Create Mongoose schemas using Zod.",
  "scripts": {
    "format:check": "prettier --check **/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue}",
    "format:fix": "prettier --write **/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue}",
    "lint:eslint": "npm run lint:eslint:nocache -- --cache",
    "lint:eslint:quiet": "npm run lint:eslint -- --quiet",
    "lint:eslint:nocache": "eslint --ext .js,.ts,.cjs,.mjs,.tsx,.cts,.mts,.vue .",
    "lint:eslint:nocache:quiet": "npm run lint:eslint:nocache -- --quiet",
    "lint:eslint:vue": "npm run lint:eslint:vue:nocache -- --cache",
    "lint:eslint:vue:nocache": "eslint --ext .vue .",
    "lint:eslint:fix": "npm run lint:eslint:nocache -- --fix",
    "lint:eslint:fix:quiet": "npm run lint:eslint:nocache:quiet -- --fix",
    "lint:types": "tsc --noEmit",
    "lint": "npm run lint:types && npm run lint:eslint",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test": "npm run lint && npm run test:unit",
    "build": "rimraf dist && tsup src/index.ts --dts --treeshake --format esm,cjs --target=node20",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "homepage": "https://github.com/andreww2012/mongoose-zod",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreww2012/mongoose-zod"
  },
  "bugs": {
    "url": "https://github.com/andreww2012/mongoose-zod/issues/new"
  },
  "keywords": [
    "mongoose",
    "zod",
    "mongodb"
  ],
  "author": "andreww2012",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-disable-autofix": "^6.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-type-assertion": "^1.3.0",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "jest": "^30.3.0",
    "jest-extended": "^7.0.0",
    "mongodb-memory-server": "^11.1.0",
    "mongoose": "9.6.1",
    "mongoose-lean-defaults": "2.3.1",
    "mongoose-lean-getters": "2.3.1",
    "mongoose-lean-virtuals": "2.1.0",
    "mongoose-long": "^0.8.0",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-jest-mock-import-meta": "^1.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "zod": "4.4.2"
  },
  "peerDependencies": {
    "mongoose": ">=9 <10",
    "mongoose-lean-defaults": ">=2 <3",
    "mongoose-lean-getters": ">=2 <3",
    "mongoose-lean-virtuals": ">=2 <3",
    "zod": ">=4.4.2 <5"
  },
  "peerDependenciesMeta": {
    "mongoose-lean-defaults": {
      "optional": true
    },
    "mongoose-lean-getters": {
      "optional": true
    },
    "mongoose-lean-virtuals": {
      "optional": true
    }
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  }
}
